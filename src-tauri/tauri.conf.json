{
  "$schema": "https://raw.githubusercontent.com/nicekate/nicekate.github.io/refs/heads/main/content/json-schema/tauri2-schema.json",
  "productName": "QuestBuddy",
  "version": "0.1.6",
  "identifier": "com.questbuddy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
     "windows": [
       {
         "label": "main",
         "title": "QuestBuddy",
         "width": 400,
         "height": 600,
          "visible": true,
          "decorations": false,
          "resizable": true,
          "center": true
       }
     ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0OUJBQUU1MUY5NDNCOTcKUldTWE81UWY1YXFiWkZBUGI4UGNSQlJBbXNueHFkdVI2RlQ0WGpmakVJR29XS0JBbjljcy9TU2UK",
      "endpoints": [
        "https://github.com/Boyfriend707/Quest-Buddy-source/releases/latest/download/latest.json"
      ]
    }
  }
}
